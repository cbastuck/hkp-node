# Settings for `npm run withPublicCoordinator`: a coordinator other machines on
# the network can reach. Copy to .env.public-coordinator (not committed) and
# fill in. Anything set in the shell overrides what is written here.

# Listen on every interface, and the address others reach this machine at.
HOST=0.0.0.0
EXTERNAL_HOST=192.168.1.10
COORDINATOR_ENABLED=true

# Who may sign in: the Auth0 tenant, and the client ids whose tokens it
# accepts (comma-separated).
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=your-client-id

# Who may own boards here (comma-separated).
ALLOWED_EMAILS=you@example.com
