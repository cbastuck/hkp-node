# Settings for `npm run dev` (and `start`, `withCoordinator`). Copy to .env
# (not committed) and fill in. Anything set in the shell overrides what is
# written here.

# Which server this is. Required: every hkp-node is a named instance and keeps
# its state in ~/.hkp/node-<instance>/, apart from any other on this machine.
# Two servers cannot run as the same instance at once.
HKP_INSTANCE=dev

# Who may sign in: the Auth0 tenant, and the client ids whose tokens it
# accepts (comma-separated). Without them the server binds 0.0.0.0 and refuses
# to start; set HOST=127.0.0.1 instead to run without sign-in, from this
# machine only (as `npm run localOnly` does).
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=your-client-id

# Who may own boards here (comma-separated).
ALLOWED_EMAILS=you@example.com
